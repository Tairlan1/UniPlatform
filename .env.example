# Скопируйте этот файл в .env.local (для локальной разработки) или
# .env.production (для боевого сервера) и укажите реальный адрес.
# Vite подхватывает переменные с префиксом VITE_ автоматически.

# Адрес запущенного api_analyze.py (репозиторий Shyn).
# Локально по умолчанию: http://127.0.0.1:5001
# На боевом сервере вуза - реальный домен/адрес бэкенда:
VITE_SHYN_API_BASE=http://127.0.0.1:5001
